---
import { getLang, langStaticPaths, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import AsciiLance from "@/components/AsciiLance.astro";
import { Icon } from "astro-icon/components";
import { EMAIL, FULL_NAME, SOCIAL_LINKS } from "@/consts";

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`${t("contact.title")} — ${FULL_NAME}`}>
  <Section
    title="Contact"
    titleKey="contact.title"
    variant="primary"
    full_screen
    visual="lattice"
  >
    <div
      slot="ornament"
      class="pointer-events-none absolute inset-y-0 left-10 hidden items-center xl:flex"
    >
      <AsciiLance orientation="vertical" point="up" length={64} />
    </div>
    <div
      slot="ornament"
      class="pointer-events-none absolute inset-y-0 right-10 hidden items-center xl:flex"
    >
      <AsciiLance orientation="vertical" point="up" length={64} />
    </div>
    <div class="max-w-3xl mx-auto space-y-10">
      <!-- Avatar -->
      <div class="flex justify-center">
        <div
          class="relative w-32 h-32 rounded-full border-2 border-[var(--border-color)] overflow-hidden bg-[var(--bg-card)]"
        >
          <span
            class="absolute inset-0 grid place-items-center text-5xl text-[var(--text-muted)] opacity-0 transition-opacity"
            aria-hidden="true">A</span
          >
          <img
            src="/images/mainPfp.webp"
            class="relative z-10 w-full h-full object-cover"
            loading="lazy"
            onerror="this.style.display='none'; this.previousElementSibling && this.previousElementSibling.classList.remove('opacity-0')"
            alt={t("images.mainPortrait")}
          />
        </div>
      </div>

      <!-- Email -->
      <div class="text-center space-y-3">
        <h2 class="text-xl text-[var(--text-secondary)]">
          {t("contact.email.title")}
        </h2>
        <div class="flex items-center justify-center gap-3">
          <code
            class="text-lg md:text-xl bg-[var(--bg-card)] border border-[var(--border-color)] px-5 py-3 select-all rounded-lg"
          >
            {EMAIL}
          </code>
          <button
            type="button"
            class="border border-[var(--border-color)] hover:border-white p-3 transition-all hover:bg-white hover:text-black group rounded-lg"
            title={t("contact.email.copyTitle")}
            aria-label={t("contact.email.copyTitle")}
            data-copy={EMAIL}
            data-copy-success={t("contact.email.copySuccess")}
            data-copy-error={t("contact.email.copyError")}
            data-copy-feedback="copy-feedback"
          >
            <Icon name="mdi:content-copy" class="w-5 h-5" aria-hidden="true" />
          </button>
        </div>
        <p
          id="copy-feedback"
          class="text-sm text-[var(--text-muted)] h-5"
          role="status"
        >
        </p>
      </div>

      <!-- Professional Links -->
      <div class="space-y-3">
        <h2 class="text-xl text-[var(--text-secondary)] text-center">
          {t("contact.professional.title")}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href={SOCIAL_LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-[var(--border-color)] hover:border-white bg-[var(--bg-card)] p-5 flex flex-col items-center gap-3 transition-all group hover:bg-white hover:text-black rounded-lg"
          >
            <Icon name="simple-icons:github" class="w-8 h-8" />
            <div class="text-center">
              <p class="font-bold">GitHub</p>
              <p
                class="text-xs text-[var(--text-muted)] group-hover:text-black/60"
              >
                @Kitsunee03
              </p>
            </div>
          </a>
          <a
            href={SOCIAL_LINKS.itchio}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-[var(--border-color)] hover:border-white bg-[var(--bg-card)] p-5 flex flex-col items-center gap-3 transition-all group hover:bg-white hover:text-black rounded-lg"
          >
            <Icon name="simple-icons:itchdotio" class="w-8 h-8" />
            <div class="text-center">
              <p class="font-bold">Itch.io</p>
              <p
                class="text-xs text-[var(--text-muted)] group-hover:text-black/60"
              >
                @Kitsunee03
              </p>
            </div>
          </a>
          <a
            href={SOCIAL_LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-[var(--border-color)] hover:border-white bg-[var(--bg-card)] p-5 flex flex-col items-center gap-3 transition-all group hover:bg-white hover:text-black rounded-lg"
          >
            <Icon name="simple-icons:linkedin" class="w-8 h-8" />
            <div class="text-center">
              <p class="font-bold">LinkedIn</p>
              <p
                class="text-xs text-[var(--text-muted)] group-hover:text-black/60"
              >
                Arnau Miragall
              </p>
            </div>
          </a>
        </div>
      </div>

      <!-- Social Media -->
      <div class="space-y-3">
        <h2 class="text-xl text-[var(--text-secondary)] text-center">
          {t("contact.social.title")}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-md mx-auto">
          <a
            href={SOCIAL_LINKS.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-[var(--border-color)] hover:border-white bg-[var(--bg-card)] p-5 flex items-center gap-4 transition-all group hover:bg-white hover:text-black rounded-lg"
          >
            <Icon name="simple-icons:instagram" class="w-7 h-7" />
            <div>
              <p class="font-bold">Instagram</p>
              <p
                class="text-xs text-[var(--text-muted)] group-hover:text-black/60"
              >
                @kitsunee03
              </p>
            </div>
          </a>
          <a
            href={SOCIAL_LINKS.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-[var(--border-color)] hover:border-white bg-[var(--bg-card)] p-5 flex items-center gap-4 transition-all group hover:bg-white hover:text-black rounded-lg"
          >
            <Icon name="simple-icons:tiktok" class="w-7 h-7" />
            <div>
              <p class="font-bold">TikTok</p>
              <p
                class="text-xs text-[var(--text-muted)] group-hover:text-black/60"
              >
                @kitsunee03
              </p>
            </div>
          </a>
        </div>
      </div>

      <!-- Direct Contact Form -->
      <div class="space-y-3">
        <h2 class="text-xl text-[var(--text-secondary)] text-center">
          {t("contact.direct.title")}
        </h2>
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="max-w-lg mx-auto space-y-4"
          id="contact-form"
          data-sending={t("contact.form.sending")}
          data-success={t("contact.form.success")}
          data-error={t("contact.form.error")}
          data-network-error={t("contact.form.networkError")}
        >
          <input
            type="hidden"
            name="access_key"
            value="5fcb267d-6a30-4ebf-aeef-f02ce90e25e9"
          />
          <input
            type="hidden"
            name="subject"
            value={t("contact.form.subject")}
          />
          <input
            type="hidden"
            name="from_name"
            value={t("contact.form.fromName")}
          />
          <div>
            <label
              for="contact-name"
              class="block text-sm text-[var(--text-muted)] mb-1"
              >{t("contact.form.name.label")}</label
            >
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              class="w-full bg-[var(--bg-card)] border border-[var(--border-color)] focus:border-white px-4 py-2.5 text-white outline-none transition-colors rounded-lg"
              placeholder={t("contact.form.name.placeholder")}
            />
          </div>
          <div>
            <label
              for="contact-email"
              class="block text-sm text-[var(--text-muted)] mb-1"
              >{t("contact.form.email.label")}</label
            >
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              class="w-full bg-[var(--bg-card)] border border-[var(--border-color)] focus:border-white px-4 py-2.5 text-white outline-none transition-colors rounded-lg"
              placeholder={t("contact.form.email.placeholder")}
            />
          </div>
          <div>
            <label
              for="contact-message"
              class="block text-sm text-[var(--text-muted)] mb-1"
              >{t("contact.form.message.label")}</label
            >
            <textarea
              id="contact-message"
              name="message"
              required
              rows="5"
              class="w-full bg-[var(--bg-card)] border border-[var(--border-color)] focus:border-white px-4 py-2.5 text-white outline-none transition-colors resize-none rounded-lg"
              placeholder={t("contact.form.message.placeholder")}></textarea>
          </div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full border border-[var(--border-color)] hover:border-white bg-[var(--bg-card)] hover:bg-white hover:text-black py-3 font-bold transition-all rounded-lg"
            >{t("contact.form.submit")}</button
          >
          <p
            id="form-feedback"
            role="status"
            class="text-sm text-center text-[var(--text-muted)] h-5"
          >
          </p>
        </form>
      </div>
    </div>
  </Section>
</Layout>

<script>
  // Messages come translated in the data attributes of the form.
  function initContactForm() {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    if (!form || form.dataset.ready === "true") return;
    form.dataset.ready = "true";
    const feedback = document.getElementById("form-feedback");
    const submit = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement | null;
    const label = submit?.textContent || "";
    const say = (text = "") => {
      if (feedback) feedback.textContent = text;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submit) {
        submit.textContent = form.dataset.sending || "";
        submit.disabled = true;
      }
      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await response.json();
        if (data.success) {
          say(form.dataset.success);
          form.reset();
        } else {
          say(form.dataset.error);
        }
      } catch {
        say(form.dataset.networkError);
      }
      if (submit) {
        submit.textContent = label;
        submit.disabled = false;
      }
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
