---
import {
  getLang,
  langStaticPaths,
  localizePath,
  useTranslations,
} from "@/i18n";
import Hero from "@/components/Hero.astro";
import Section from "@/components/Section.astro";
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectDetailModal from "@/components/ProjectDetailModal.astro";
import ToolCarousel from "@/components/ToolCarousel.astro";
import ContactSummary from "@/components/ContactSummary.astro";
import GrappleGame from "@/components/GrappleGame.astro";
import { Icon } from "astro-icon/components";
import { FULL_NAME } from "@/consts";
import { SKILLS } from "@/data/skills";
import { EDUCATION } from "@/data/education";
import { getProjects } from "@/lib/projects";

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const featuredProjects = (await getProjects(lang)).filter(
  (project) => project.data.featured,
);
const dropdownCategories = ["engine", "programming", "tools"] as const;
---

<Layout title={`${FULL_NAME} — ${t("meta.portfolio")}`}>
  <Hero />

  <!-- Tool Carousel -->
  <Section
    title="Tools & Technologies"
    titleKey="home.sections.tools"
    variant="secondary"
  >
    <ToolCarousel />
  </Section>

  <!-- About Me Preview -->
  <Section
    title="About Me"
    titleKey="home.sections.about"
    variant="primary"
    visual="lattice"
  >
    <div
      class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 items-center"
    >
      <div class="md:col-span-1 flex justify-center">
        <div
          class="relative w-48 h-48 md:w-56 md:h-auto md:aspect-square rounded-lg border border-[var(--border-color)] overflow-hidden bg-[var(--bg-card)]"
        >
          <span
            class="absolute inset-0 grid place-items-center text-6xl text-[var(--text-muted)] opacity-0 transition-opacity"
            aria-hidden="true">A</span
          >
          <img
            src="/images/mainPfp.webp"
            class="relative z-10 w-full h-full object-cover"
            loading="lazy"
            onerror="this.style.display='none'; this.previousElementSibling && this.previousElementSibling.classList.remove('opacity-0')"
            alt={t("images.mainPortrait")}
          />
        </div>
      </div>
      <div class="md:col-span-2 space-y-4">
        <p class="text-[var(--text-secondary)] leading-relaxed">
          {t("home.about.short")}
        </p>
        <a
          href={localizePath("/about", lang)}
          class="inline-flex items-center gap-2 text-sm text-[var(--text-muted)] hover:text-white transition-colors border-b border-[var(--border-color)] hover:border-white pb-0.5"
          >{t("home.about.readMore")}</a
        >
      </div>
    </div>
  </Section>

  <!-- Featured Projects -->
  <Section
    title="Featured Projects"
    titleKey="home.sections.featured"
    variant="secondary"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        featuredProjects.map((project) => (
          <ProjectCard
            projectId={project.id}
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            engine={project.data.engine}
            image={project.data.image}
            video={project.data.video}
            ambient={project.data.ambient}
          />
        ))
      }
    </div>
    <ProjectDetailModal projects={featuredProjects} />
    <div class="flex justify-center mt-8">
      <a
        href={localizePath("/projects", lang)}
        class="magnetic-link border border-[var(--border-color)] hover:border-white px-8 py-3 rounded-md transition-all hover:bg-white hover:text-black text-sm"
        data-magnetic-link>{t("home.projects.viewAll")}</a
      >
    </div>
  </Section>

  <!-- About Me & My Work — Dropdowns -->
  <Section
    title="About Me & My Work"
    titleKey="home.sections.aboutWork"
    variant="primary"
    visual="lattice"
  >
    <div class="max-w-3xl mx-auto space-y-3">
      {
        dropdownCategories.map((cat, i) => {
          const items = SKILLS.filter((s) => s.category === cat);
          return (
            <div class="border border-[var(--border-color)] bg-[var(--bg-primary)] rounded-lg hover:border-[var(--border-hover)] transition-colors">
              <button
                type="button"
                class="accordion-toggle w-full flex items-center justify-between px-5 py-4 text-left hover:bg-[var(--bg-card)] transition-colors rounded-lg"
                data-accordion-toggle
                aria-controls={`home-dd-${i}`}
                aria-expanded="false"
              >
                <span class="text-[var(--text-secondary)]">
                  <span aria-hidden="true">❯ </span>
                  <span>{t(`home.categories.${cat}`)}</span>
                </span>
                <span
                  class="accordion-chevron text-[var(--text-muted)] transition-transform duration-200 shrink-0"
                  aria-hidden="true"
                >
                  ▼
                </span>
              </button>
              <div id={`home-dd-${i}`} class="home-dd-content hidden px-5 pb-5">
                <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-4 pt-2">
                  {items.map((skill) => (
                    <div class="relative flex flex-col items-center gap-2 group transition-transform duration-200 hover:scale-110 hover:z-10">
                      <div class="w-14 h-14 grid place-items-center rounded-lg bg-[var(--bg-tertiary)] border border-[var(--border-color)] group-hover:border-[var(--border-hover)] transition-all duration-200">
                        <Icon
                          name={skill.icon}
                          class="w-8 h-8"
                          style={skill.color ? `color: ${skill.color}` : ""}
                          aria-hidden="true"
                        />
                      </div>
                      <span class="text-xs text-[var(--text-muted)] group-hover:text-[var(--text-secondary)] transition-colors text-center">
                        {skill.name}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }

      <!-- My Education -->
      <div
        class="border border-[var(--border-color)] bg-[var(--bg-primary)] rounded-lg hover:border-[var(--border-hover)] transition-colors"
      >
        <button
          type="button"
          class="accordion-toggle w-full flex items-center justify-between px-5 py-4 text-left hover:bg-[var(--bg-card)] transition-colors rounded-lg"
          data-accordion-toggle
          aria-controls="home-dd-edu"
          aria-expanded="false"
        >
          <span class="text-[var(--text-secondary)]">
            <span aria-hidden="true">❯ </span>
            <span>{t("home.dropdown.education")}</span>
          </span>
          <span
            class="accordion-chevron text-[var(--text-muted)] transition-transform duration-200 shrink-0"
            aria-hidden="true">▼</span
          >
        </button>
        <div id="home-dd-edu" class="home-dd-content hidden px-5 pb-5">
          <div class="space-y-3 pt-2">
            {
              EDUCATION.map((edu) => (
                <div class="flex gap-3 items-start">
                  <Icon
                    name={edu.icon}
                    class="w-5 h-5 text-[var(--text-muted)] mt-0.5 shrink-0"
                  />
                  <div>
                    <p class="text-sm text-[var(--text-secondary)]">
                      {t(`education.${edu.id}.title`)}
                    </p>
                    <p class="text-xs text-[var(--text-muted)]">
                      <span>{t(`education.${edu.id}.institution`)}</span>
                      <span aria-hidden="true"> · </span>
                      <span>{t(`education.${edu.id}.period`)}</span>
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Teamwork -->
      <div
        class="border border-[var(--border-color)] bg-[var(--bg-primary)] rounded-lg hover:border-[var(--border-hover)] transition-colors"
      >
        <button
          type="button"
          class="accordion-toggle w-full flex items-center justify-between px-5 py-4 text-left hover:bg-[var(--bg-card)] transition-colors rounded-lg"
          data-accordion-toggle
          aria-controls="home-dd-team"
          aria-expanded="false"
        >
          <span class="text-[var(--text-secondary)]">
            <span aria-hidden="true">❯ </span>
            <span>{t("home.dropdown.teamwork.title")}</span>
          </span>
          <span
            class="accordion-chevron text-[var(--text-muted)] transition-transform duration-200 shrink-0"
            aria-hidden="true">▼</span
          >
        </button>
        <div id="home-dd-team" class="home-dd-content hidden px-5 pb-5">
          <p
            class="text-sm text-[var(--text-muted)] leading-relaxed pt-2 pl-4 border-l border-[var(--border-color)]"
          >
            {t("home.dropdown.teamwork.body")}
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Opt-in mini-game -->
  <Section title="Play" titleKey="home.sections.play" variant="secondary">
    <GrappleGame />
  </Section>

  <!-- Contact Summary -->
  <Section
    title="Contact"
    titleKey="home.sections.contact"
    variant="primary"
    visual="lattice"
  >
    <ContactSummary />
  </Section>
</Layout>
