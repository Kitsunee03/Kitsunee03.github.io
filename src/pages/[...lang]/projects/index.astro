---
import { getLang, langStaticPaths, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ContactSummary from "@/components/ContactSummary.astro";
import ProjectDetailModal from "@/components/ProjectDetailModal.astro";
import { ENGINES, FULL_NAME } from "@/consts";
import { getProjects } from "@/lib/projects";

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const allProjects = await getProjects(lang);
---

<Layout title={`${t("projects.title")} — ${FULL_NAME}`}>
  <Section title="Projects" titleKey="projects.title" variant="primary">
    <!-- Engine Filters -->
    <div class="flex flex-wrap gap-3 justify-center mb-10" data-project-filters>
      <button
        type="button"
        aria-pressed="true"
        class="engine-filter magnetic-link active border border-white bg-white text-black px-4 py-1.5 text-sm transition-all hover:bg-white hover:text-black rounded-md"
        data-engine="all"
        data-magnetic-link>{t("projects.filter.all")}</button
      >
      {
        ENGINES.map((engine) => (
          <button
            type="button"
            aria-pressed="false"
            class="engine-filter magnetic-link border border-[var(--border-color)] px-4 py-1.5 text-sm transition-all hover:bg-white hover:text-black text-[var(--text-secondary)] rounded-md"
            data-engine={engine}
            data-magnetic-link
          >
            {engine}
          </button>
        ))
      }
    </div>

    <!-- Project Grid -->
    <div
      id="projects-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {
        allProjects.map((project) => (
          <div class="project-item" data-engine={project.data.engine}>
            <ProjectCard
              projectId={project.id}
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              engine={project.data.engine}
              image={project.data.image}
              video={project.data.video}
              ambient={project.data.ambient}
            />
          </div>
        ))
      }
    </div>
    <ProjectDetailModal projects={allProjects} />

    <!-- Empty state -->
    <div
      id="no-projects"
      class="hidden text-center py-16 text-[var(--text-muted)]"
    >
      <p class="text-lg">{t("projects.empty")}</p>
    </div>
  </Section>

  <Section
    title="Contact"
    titleKey="contact.title"
    variant="secondary"
    visual="lattice"
  >
    <ContactSummary compact />
  </Section>
</Layout>

<script>
  function initProjectFilters() {
    const filterRoot = document.querySelector<HTMLElement>(
      "[data-project-filters]",
    );
    if (!filterRoot || filterRoot.dataset.initialized === "true") return;

    filterRoot.dataset.initialized = "true";
    filterRoot.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement).closest<HTMLButtonElement>(
        ".engine-filter",
      );
      if (!target) return;

      const filterBtns =
        filterRoot.querySelectorAll<HTMLButtonElement>(".engine-filter");
      const projectItems =
        document.querySelectorAll<HTMLElement>(".project-item");
      const noProjects = document.getElementById("no-projects");
      const engine = target.getAttribute("data-engine");

      filterBtns.forEach((button) => {
        button.setAttribute("aria-pressed", String(button === target));
        button.classList.remove(
          "active",
          "bg-white",
          "text-black",
          "border-white",
        );
        button.classList.add(
          "border-[var(--border-color)]",
          "text-[var(--text-secondary)]",
        );
      });
      target.classList.add("active", "bg-white", "text-black", "border-white");
      target.classList.remove(
        "border-[var(--border-color)]",
        "text-[var(--text-secondary)]",
      );

      let visibleCount = 0;
      projectItems.forEach((item) => {
        const isVisible = engine === "all" || item.dataset.engine === engine;
        item.style.display = isVisible ? "" : "none";
        if (isVisible) visibleCount++;
      });

      noProjects?.classList.toggle("hidden", visibleCount > 0);
    });
  }

  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>
