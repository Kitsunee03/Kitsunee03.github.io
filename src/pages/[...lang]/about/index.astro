---
import { getLang, langStaticPaths, useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import SkillCard from "@/components/SkillCard.astro";
import QAAccordion from "@/components/QAAccordion.astro";
import Timeline from "@/components/Timeline.astro";
import ContactSummary from "@/components/ContactSummary.astro";
import { Icon } from "astro-icon/components";
import { FULL_NAME, SOCIAL_LINKS } from "@/consts";
import { SPECIALIZATIONS } from "@/data/specializations";
import { EDUCATION } from "@/data/education";
import { EXPERIENCE } from "@/data/experience";
import { SKILLS } from "@/data/skills";
import { QA_ITEMS } from "@/data/qa";

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const categories = ["programming", "engine", "design", "tools"] as const;

const profileSlides = [
  { id: "professional", image: "/images/firstPfp.webp" },
  { id: "personal", image: "/images/secondPfp.webp" },
  { id: "projects", image: "/images/thirdPfp.webp" },
].map((slide) => ({
  ...slide,
  suffix: t(`about.profile.${slide.id}.suffix`),
  alt: t(`about.profile.${slide.id}.alt`),
  paragraphs: [
    t(`about.profile.${slide.id}.p1`),
    t(`about.profile.${slide.id}.p2`),
  ],
}));
---

<Layout title={`${t("about.sections.about")} — ${FULL_NAME}`}>
  <!-- Photo + Description -->
  <Section
    title="About Me"
    titleKey="about.sections.about"
    titleSuffix={profileSlides[0].suffix}
    variant="primary"
    visual="lattice"
  >
    <div
      class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 items-start"
    >
      <div class="md:col-span-1 flex justify-center">
        <div class="relative w-56 h-56 md:w-full md:h-auto md:aspect-square">
          <!-- Image carousel -->
          <div
            class="relative w-full h-full rounded-lg border border-[var(--border-color)] overflow-hidden bg-[var(--bg-card)]"
          >
            {
              profileSlides.map((slide, i) => (
                <img
                  src={slide.image}
                  alt={slide.alt}
                  class:list={[
                    "about-profile-img absolute inset-0 w-full h-full object-cover rounded-lg transition-opacity duration-300",
                    i === 0 ? "opacity-100" : "opacity-0",
                  ]}
                  data-index={i}
                  data-title={slide.suffix}
                  loading="lazy"
                  onerror="this.dataset.failed='true'; this.style.display='none'"
                />
              ))
            }
            <div
              class="about-profile-fallback absolute inset-0 flex items-center justify-center text-[var(--text-muted)] pointer-events-none opacity-0 transition-opacity"
            >
              <span class="text-8xl">A</span>
            </div>
          </div>
          <!-- Arrow controls -->
          <button
            type="button"
            id="profile-prev"
            class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/70 hover:bg-black/90 rounded-full grid place-items-center transition-colors z-10 text-white"
            aria-label={t("about.profile.prev")}
          >
            ◀
          </button>
          <button
            type="button"
            id="profile-next"
            class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/70 hover:bg-black/90 rounded-full grid place-items-center transition-colors z-10 text-white"
            aria-label={t("about.profile.next")}
          >
            ▶
          </button>
          <!-- Dots indicator -->
          <div
            class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5 z-10"
            aria-hidden="true"
          >
            {
              profileSlides.map((_, i) => (
                <div
                  class:list={[
                    "profile-dot w-2 h-2 rounded-full transition-colors",
                    i === 0 ? "bg-white" : "bg-white/40",
                  ]}
                  data-index={i}
                />
              ))
            }
          </div>
        </div>
      </div>
      <div class="md:col-span-2" aria-live="polite">
        {
          profileSlides.map((slide, i) => (
            <div
              class:list={[
                "about-profile-text space-y-4",
                i === 0 ? "block" : "hidden",
              ]}
              data-index={i}
            >
              {slide.paragraphs.map((paragraph) => (
                <p class="text-[var(--text-secondary)] leading-relaxed">
                  {paragraph}
                </p>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Specializations -->
  <Section
    title="Specializations"
    titleKey="about.sections.specializations"
    variant="secondary"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {
        SPECIALIZATIONS.map((spec) => (
          <div class="border border-[var(--border-color)] hover:border-[var(--border-hover)] bg-[var(--bg-card)] p-6 transition-all group rounded-lg">
            <div class="w-12 h-12 rounded-lg bg-[var(--bg-tertiary)] grid place-items-center mb-4 group-hover:bg-white/10 transition-colors">
              <Icon
                name={spec.icon}
                class="w-6 h-6 text-[var(--text-secondary)]"
                aria-hidden="true"
              />
            </div>
            <h3 class="text-lg mb-2">
              {t(`specializations.${spec.id}.title`)}
            </h3>
            <p class="text-[var(--text-muted)] text-sm leading-relaxed">
              {t(`specializations.${spec.id}.description`)}
            </p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Education and Experience -->
  <Section
    title="Education & Experience"
    titleKey="about.sections.educationExperience"
    showTitle={false}
    variant="primary"
    visual="lattice"
  >
    <div
      class="mx-auto grid max-w-6xl grid-cols-1 gap-12 md:grid-cols-2 md:gap-10 lg:gap-16"
    >
      <div>
        <h2 class="mb-8 text-2xl font-normal text-white md:text-3xl">
          {t("about.sections.education")}
        </h2>
        {
          EDUCATION.map((edu, i) => (
            <Timeline
              entryKey={`education.${edu.id}`}
              icon={edu.icon}
              current={edu.current}
              isLast={i === EDUCATION.length - 1}
            />
          ))
        }
      </div>
      <div>
        <h2 class="mb-8 text-2xl font-normal text-white md:text-3xl">
          {t("about.sections.experience")}
        </h2>
        {
          EXPERIENCE.map((job, i) => (
            <Timeline
              entryKey={`experience.${job.id}`}
              mark={job.mark}
              logo={job.logo}
              link={job.url}
              icon={job.icon}
              current={job.current}
              isLast={i === EXPERIENCE.length - 1}
            />
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Technologies -->
  <Section
    title="Technologies"
    titleKey="about.sections.technologies"
    variant="secondary"
    className="relative z-10"
  >
    <div class="max-w-5xl mx-auto space-y-8">
      {
        categories.map((category) => (
          <div>
            <h3 class="text-sm text-[var(--text-muted)] mb-4 tracking-wider uppercase">
              {t(`about.categories.${category}`)}
            </h3>
            <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-4">
              {SKILLS.filter((skill) => skill.category === category).map(
                (skill) => (
                  <SkillCard
                    id={skill.id}
                    name={skill.name}
                    icon={skill.icon}
                    color={skill.color}
                    descriptionKey={`skills.${skill.id}.description`}
                  />
                ),
              )}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Q&A -->
  <Section
    title="Q&A"
    titleKey="about.sections.qa"
    variant="primary"
    visual="lattice"
  >
    <div class="max-w-3xl mx-auto space-y-3">
      {QA_ITEMS.map((id, i) => <QAAccordion entryKey={`qa.${id}`} index={i} />)}
    </div>
  </Section>

  <!-- GitHub & Itch.io -->
  <Section
    title="Find Me"
    titleKey="about.sections.find"
    variant="secondary"
  >
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-[var(--border-color)] hover:border-[var(--border-hover)] bg-[var(--bg-card)] p-6 flex items-center gap-4 transition-all group rounded-lg"
      >
        <Icon
          name="simple-icons:github"
          class="w-10 h-10 text-white"
          aria-hidden="true"
        />
        <div>
          <h3 class="text-lg group-hover:text-white transition-colors">
            GitHub
          </h3>
          <p class="text-[var(--text-muted)] text-sm">@Kitsunee03</p>
        </div>
      </a>
      <a
        href={SOCIAL_LINKS.itchio}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-[var(--border-color)] hover:border-[var(--border-hover)] bg-[var(--bg-card)] p-6 flex items-center gap-4 transition-all group rounded-lg"
      >
        <Icon
          name="simple-icons:itchdotio"
          class="w-10 h-10 text-[#FA5C5C]"
          aria-hidden="true"
        />
        <div>
          <h3 class="text-lg group-hover:text-white transition-colors">
            Itch.io
          </h3>
          <p class="text-[var(--text-muted)] text-sm">@Kitsunee03</p>
        </div>
      </a>
    </div>
  </Section>

  <!-- Contact -->
  <Section
    title="Contact"
    titleKey="about.sections.contact"
    variant="primary"
    visual="lattice"
  >
    <ContactSummary compact />
  </Section>
</Layout>

<script>
  function initProfileCarousel() {
    const imgs =
      document.querySelectorAll<HTMLImageElement>(".about-profile-img");
    if (!imgs.length) return;
    const dots = document.querySelectorAll(".profile-dot");
    const textBlocks = document.querySelectorAll(".about-profile-text");
    const suffixSpan = document.querySelector<HTMLElement>(
      "#about-me .section-title-suffix",
    );
    const fallback = document.querySelector<HTMLElement>(
      ".about-profile-fallback",
    );
    const prevBtn = document.getElementById("profile-prev");
    const nextBtn = document.getElementById("profile-next");

    let current = 0;
    const total = imgs.length;

    const showImage = (index: number) => {
      imgs.forEach((img, i) => {
        img.style.opacity = i === index ? "1" : "0";
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-white", i === index);
        dot.classList.toggle("bg-white/40", i !== index);
      });
      textBlocks.forEach((block, i) => {
        block.classList.toggle("hidden", i !== index);
        block.classList.toggle("block", i === index);
      });

      const activeImg = imgs[index];
      // The suffix is already translated in the markup.
      if (suffixSpan) suffixSpan.textContent = activeImg.dataset.title || "";
      const showFallback =
        activeImg.dataset.failed === "true" ||
        activeImg.style.display === "none";
      fallback?.classList.toggle("opacity-0", !showFallback);
      fallback?.classList.toggle("opacity-100", showFallback);
      current = index;
    };

    prevBtn?.addEventListener("click", () =>
      showImage((current - 1 + total) % total),
    );
    nextBtn?.addEventListener("click", () => showImage((current + 1) % total));
  }

  document.addEventListener("astro:page-load", initProfileCarousel);
</script>
