---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import SkillCard from "@/components/SkillCard.astro";
import QAAccordion from "@/components/QAAccordion.astro";
import Timeline from "@/components/Timeline.astro";
import ContactSummary from "@/components/ContactSummary.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import { Icon } from "astro-icon/components";
import { FULL_NAME, SOCIAL_LINKS } from "@/consts";
import { SPECIALIZATIONS } from "@/data/specializations";
import { EDUCATION } from "@/data/education";
import { SKILLS } from "@/data/skills";
import { QA_ITEMS } from "@/data/qa";

const categoryLabels = {
  programming: { label: "Programming Languages", key: "about.categories.programming" },
  engine: { label: "Engines & Frameworks", key: "about.categories.engine" },
  design: { label: "Design Tools", key: "about.categories.design" },
  tools: { label: "Dev Tools", key: "about.categories.tools" },
};
const categories = ["programming", "engine", "design", "tools"] as const;

const profileSlides = [
  {
    id: "professional",
    image: "/images/firstPfp.png",
    titleSuffix: "Professional",
    titleSuffixKey: "about.profile.professional.suffix",
    alt: "Professional profile portrait",
    altKey: "about.profile.professional.alt",
    paragraphs: [
      "I'm a gameplay programmer and game development student at ENTI in Barcelona. I focus on building gameplay systems, player feel, and rapid prototypes that can be tested early.",
      "My background in game design helps me translate ideas into mechanics, and I've led small university teams (3-8 people) as a producer, keeping scope and priorities clear.",
    ],
    paragraphKeys: [
      "about.profile.professional.p1",
      "about.profile.professional.p2",
    ],
  },
  {
    id: "personal",
    image: "/images/secondPfp.png",
    titleSuffix: "Personal",
    titleSuffixKey: "about.profile.personal.suffix",
    alt: "Personal profile portrait",
    altKey: "about.profile.personal.alt",
    paragraphs: [
      "I'm calm and introverted, so I tend to listen first and then share honest feedback when it helps the project. I enjoy teams where ideas are discussed openly and decisions are explained.",
      "Japanese culture inspires a lot of my aesthetic choices, and I want this portfolio to feel personal rather than generic.",
    ],
    paragraphKeys: [
      "about.profile.personal.p1",
      "about.profile.personal.p2",
    ],
  },
  {
    id: "projects",
    image: "/images/thirdPfp.png",
    titleSuffix: "Projects & Experience",
    titleSuffixKey: "about.profile.projects.suffix",
    alt: "Project-focused profile portrait",
    altKey: "about.profile.projects.alt",
    paragraphs: [
      "All the projects here are prototypes made at university or in my free time. I enjoy level design, playtesting sessions, and iterating based on feedback.",
      "Tools I use most are Unity, Unreal Engine, Phaser, C#, C++, and Processing. I also use Audacity for basic audio editing.",
    ],
    paragraphKeys: [
      "about.profile.projects.p1",
      "about.profile.projects.p2",
    ],
  },
];
---

<Layout title={`About Me — ${FULL_NAME}`}>
  <!-- Photo + Description -->
  <Section
    title="About Me"
    titleKey="about.sections.about"
    titleSuffix={profileSlides[0].titleSuffix}
    titleSuffixKey={profileSlides[0].titleSuffixKey}
    variant="primary"
  >
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 items-start">
      <div class="md:col-span-1 flex justify-center">
        <div class="relative w-56 h-56 md:w-full md:h-auto md:aspect-square">
          <!-- Image carousel -->
          <div class="relative w-full h-full rounded-lg border border-[var(--border-color)] overflow-hidden bg-[var(--bg-card)]">
            {profileSlides.map((slide, i) => (
              <img
                src={slide.image}
                alt={slide.alt}
                class:list={[
                  "about-profile-img absolute inset-0 w-full h-full object-cover rounded-lg transition-opacity duration-300",
                  i === 0 ? "opacity-100" : "opacity-0",
                ]}
                data-index={i}
                data-title={slide.titleSuffix}
                data-title-key={slide.titleSuffixKey}
                data-i18n-attr={`alt:${slide.altKey}`}
                loading="lazy"
                onerror="this.dataset.failed='true'; this.style.display='none'"
              />
            ))}
            <div class="about-profile-fallback absolute inset-0 flex items-center justify-center text-[var(--text-muted)] pointer-events-none opacity-0 transition-opacity">
              <span class="text-8xl">A</span>
            </div>
          </div>
          <!-- Arrow controls -->
          <button
            id="profile-prev"
            class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/70 hover:bg-black/90 rounded-full grid place-items-center transition-colors z-10 text-white"
            aria-label="Previous photo"
            data-i18n-attr="aria-label:about.profile.prev"
          >
            ◀
          </button>
          <button
            id="profile-next"
            class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 bg-black/70 hover:bg-black/90 rounded-full grid place-items-center transition-colors z-10 text-white"
            aria-label="Next photo"
            data-i18n-attr="aria-label:about.profile.next"
          >
            ▶
          </button>
          <!-- Dots indicator -->
          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5 z-10">
            {profileSlides.map((_, i) => (
              <div
                class:list={[
                  "profile-dot w-2 h-2 rounded-full transition-colors",
                  i === 0 ? "bg-white" : "bg-white/40",
                ]}
                data-index={i}
              />
            ))}
          </div>
        </div>
      </div>
      <div class="md:col-span-2">
        {profileSlides.map((slide, i) => (
          <div
            class:list={["about-profile-text space-y-4", i === 0 ? "block" : "hidden"]}
            data-index={i}
          >
            {slide.paragraphs.map((paragraph, pIndex) => (
              <p
                class="text-[var(--text-secondary)] leading-relaxed"
                data-i18n={slide.paragraphKeys[pIndex]}
              >
                {paragraph}
              </p>
            ))}
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- Specializations -->
  <Section title="Specializations" titleKey="about.sections.specializations" variant="secondary">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {SPECIALIZATIONS.map((spec) => (
        <div class="border border-[var(--border-color)] hover:border-[var(--border-hover)] bg-[var(--bg-card)] p-6 transition-all group rounded-lg">
          <div class="w-12 h-12 rounded-lg bg-[var(--bg-tertiary)] grid place-items-center mb-4 group-hover:bg-white/10 transition-colors">
            <Icon name={spec.icon} class="w-6 h-6 text-[var(--text-secondary)]" />
          </div>
          <h3 class="text-lg mb-2" data-i18n={`specializations.${spec.id}.title`}>
            {spec.title}
          </h3>
          <p class="text-[var(--text-muted)] text-sm leading-relaxed" data-i18n={`specializations.${spec.id}.description`}>
            {spec.description}
          </p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Education -->
  <Section title="Education" titleKey="about.sections.education" variant="primary">
    <div class="max-w-3xl mx-auto">
      {EDUCATION.map((edu, i) => (
        <Timeline
          title={edu.title}
          institution={edu.institution}
          period={edu.period}
          description={edu.description}
          titleKey={`education.${edu.id}.title`}
          institutionKey={`education.${edu.id}.institution`}
          periodKey={`education.${edu.id}.period`}
          descriptionKey={`education.${edu.id}.description`}
          icon={edu.icon}
          isLast={i === EDUCATION.length - 1}
        />
      ))}
    </div>
  </Section>

  <!-- Technologies -->
  <Section title="Technologies" titleKey="about.sections.technologies" variant="secondary" className="relative z-10">
    <div class="max-w-5xl mx-auto space-y-8">
      {categories.map((category) => {
        const categorySkills = SKILLS.filter((s) => s.category === category);
        return (
          <div>
            <h3 class="text-sm text-[var(--text-muted)] mb-4 tracking-wider uppercase">
              <span data-i18n={categoryLabels[category].key}>{categoryLabels[category].label}</span>
            </h3>
            <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-4">
              {categorySkills.map((skill) => (
                <SkillCard
                  name={skill.name}
                  icon={skill.icon}
                  color={skill.color}
                  description={skill.description}
                  descriptionKey={`skills.${skill.id}.description`}
                />
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </Section>

  <!-- Q&A -->
  <Section title="Q&A" titleKey="about.sections.qa" variant="primary">
    <div class="max-w-3xl mx-auto space-y-3">
      {QA_ITEMS.map((item, i) => (
        <QAAccordion
          question={item.question}
          answer={item.answer}
          questionKey={`qa.${item.id}.question`}
          answerKey={`qa.${item.id}.answer`}
          index={i}
        />
      ))}
    </div>
  </Section>

  <!-- GitHub & Itch.io -->
  <Section title="Find Me" titleKey="about.sections.find" variant="secondary">
    <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-[var(--border-color)] hover:border-[var(--border-hover)] bg-[var(--bg-card)] p-6 flex items-center gap-4 transition-all group rounded-lg"
      >
        <Icon name="simple-icons:github" class="w-10 h-10 text-white" />
        <div>
          <h3 class="text-lg group-hover:text-white transition-colors">GitHub</h3>
          <p class="text-[var(--text-muted)] text-sm">@Kitsunee03</p>
        </div>
      </a>
      <a
        href={SOCIAL_LINKS.itchio}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-[var(--border-color)] hover:border-[var(--border-hover)] bg-[var(--bg-card)] p-6 flex items-center gap-4 transition-all group rounded-lg"
      >
        <Icon name="simple-icons:itchdotio" class="w-10 h-10 text-[#FA5C5C]" />
        <div>
          <h3 class="text-lg group-hover:text-white transition-colors">Itch.io</h3>
          <p class="text-[var(--text-muted)] text-sm">@Kitsunee03</p>
        </div>
      </a>
    </div>
  </Section>

  <!-- Contact -->
  <Section title="Contact" titleKey="about.sections.contact" variant="primary">
    <ContactSummary compact />
  </Section>
</Layout>

<script>
  function initProfileCarousel() {
    const imgs = document.querySelectorAll(".about-profile-img");
    const dots = document.querySelectorAll(".profile-dot");
    const textBlocks = document.querySelectorAll(".about-profile-text");
    const suffixSpan = document.querySelector("#aboutme .section-title-suffix") as HTMLElement | null;
    const slashSpan = document.querySelector("#aboutme .section-title-slash") as HTMLElement | null;
    const trailingSpan = document.querySelector("#aboutme .section-title-trailing") as HTMLElement | null;
    const fallback = document.querySelector(".about-profile-fallback") as HTMLElement | null;
    const prevBtn = document.getElementById("profile-prev");
    const nextBtn = document.getElementById("profile-next");
    if (!imgs.length) return;

    let current = 0;
    const total = imgs.length;

    function showImage(index: number) {
      imgs.forEach((img, i) => {
        (img as HTMLElement).style.opacity = i === index ? "1" : "0";
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-white", i === index);
        dot.classList.toggle("bg-white/40", i !== index);
      });
      textBlocks.forEach((block, i) => {
        block.classList.toggle("hidden", i !== index);
        block.classList.toggle("block", i === index);
      });

      const activeImg = imgs[index] as HTMLElement | undefined;
      const titleKey = activeImg?.getAttribute("data-title-key") || "";
      const titleFallback = activeImg?.getAttribute("data-title") || "";
      const titleSuffix = window.__i18n && titleKey ? window.__i18n.t(titleKey) : titleFallback;
      if (suffixSpan) {
        suffixSpan.textContent = titleSuffix;
        suffixSpan.classList.toggle("hidden", !titleSuffix);
        suffixSpan.classList.toggle("inline", !!titleSuffix);
      }
      slashSpan?.classList.toggle("hidden", !titleSuffix);
      slashSpan?.classList.toggle("inline", !!titleSuffix);
      trailingSpan?.classList.toggle("hidden", !titleSuffix);
      trailingSpan?.classList.toggle("inline", !!titleSuffix);
      const failed = activeImg?.getAttribute("data-failed") === "true";
      const hidden = activeImg?.style.display === "none";
      const showFallback = !activeImg || failed || hidden;
      fallback?.classList.toggle("opacity-0", !showFallback);
      fallback?.classList.toggle("opacity-100", showFallback);
      current = index;
    }

    showImage(0);
    prevBtn?.addEventListener("click", () => showImage((current - 1 + total) % total));
    nextBtn?.addEventListener("click", () => showImage((current + 1) % total));
    window.addEventListener("i18n:changed", () => showImage(current));
  }
  initProfileCarousel();
  document.addEventListener("astro:after-swap", initProfileCarousel);
</script>

<script>
  function initQAToggles() {
    document.querySelectorAll(".qa-toggle").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        const content = document.getElementById(targetId!);
        const chevron = btn.querySelector(".qa-chevron");
        const isExpanded = btn.getAttribute("aria-expanded") === "true";

        btn.setAttribute("aria-expanded", String(!isExpanded));
        content?.classList.toggle("hidden");
        chevron?.classList.toggle("rotate-180");
      });
    });
  }

  initQAToggles();
  document.addEventListener("astro:after-swap", initQAToggles);
</script>