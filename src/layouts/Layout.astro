---
import BaseHead from "@/components/BaseHead.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
import { DEFAULT_LANG, LANGUAGES, translations } from "@/i18n/translations";

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
---

<html lang="en" data-lang="en" class="!overflow-x-hidden">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="bg-black text-white tracking-wide !overflow-x-hidden">
    <header class="fixed top-0 w-screen z-[9999]"><Navbar /></header>
    <main class="pt-28 md:pt-20"><slot /></main>
    <footer class="w-screen bottom-0 overflow-x-hidden"><Footer /></footer>
    <script is:inline define:vars={{ DEFAULT_LANG, LANGUAGES, translations }}>
      const STORAGE_KEY = "lang";

      const normalizeLang = (value) =>
        LANGUAGES.includes(value) ? value : DEFAULT_LANG;

      const getLang = () => {
        try {
          return normalizeLang(localStorage.getItem(STORAGE_KEY));
        } catch {
          return DEFAULT_LANG;
        }
      };

      const resolveKey = (dict, key) => {
        const parts = key.split(".");
        let current = dict;
        for (const part of parts) {
          if (!current || typeof current !== "object") return undefined;
          current = current[part];
        }
        return typeof current === "string" ? current : undefined;
      };

      const t = (key, lang = getLang()) => {
        const value =
          resolveKey(translations[lang], key) ??
          resolveKey(translations[DEFAULT_LANG], key);
        return value ?? key;
      };

      const applyLang = (lang = getLang()) => {
        document.documentElement.lang = lang;
        document.documentElement.dataset.lang = lang;

        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.dataset.i18n;
          if (!key) return;
          const value = t(key, lang);
          if (value !== key) {
            el.textContent = value;
          }
        });

        document.querySelectorAll("[data-i18n-attr]").forEach((el) => {
          const spec = el.dataset.i18nAttr;
          if (!spec) return;
          spec.split(";").forEach((entry) => {
            const trimmed = entry.trim();
            if (!trimmed) return;
            const [attr, keyOverride] = trimmed.includes(":")
              ? trimmed.split(":")
              : [trimmed, el.dataset.i18n || ""];
            const key = keyOverride || el.dataset.i18n || "";
            if (!key) return;
            const value = t(key, lang);
            if (value !== key) {
              el.setAttribute(attr, value);
            }
          });
        });

        window.dispatchEvent(
          new CustomEvent("i18n:changed", { detail: { lang } }),
        );
      };

      const setLang = (lang) => {
        const next = normalizeLang(lang);
        try {
          localStorage.setItem(STORAGE_KEY, next);
        } catch {
          // ignore storage errors
        }
        applyLang(next);
        return next;
      };

      const init = () => {
        applyLang(getLang());
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }

      document.addEventListener("astro:after-swap", init);

      window.__i18n = {
        getLang,
        setLang,
        applyLang,
        t,
        LANGUAGES,
        DEFAULT_LANG,
      };

      window.dispatchEvent(
        new CustomEvent("i18n:ready", { detail: { lang: getLang() } }),
      );

      const binaryAnimationState = {
        initialized: false,
        frame: 0,
      };
      const binaryDigitPositions = new WeakMap();

      const getBinaryFields = () =>
        document.querySelectorAll("[data-binary-animation]");

      const initRevealSections = () => {
        const sections = document.querySelectorAll("[data-reveal-section]");
        if (!("IntersectionObserver" in window)) {
          sections.forEach((section) => section.classList.add("is-revealed"));
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.12 });

        sections.forEach((section) => {
          if (section.classList.contains("is-revealed")) return;
          observer.observe(section);
        });
      };

      const initMagneticLinks = () => {
        document.querySelectorAll("[data-magnetic-link]").forEach((link) => {
          if (link.dataset.magneticReady === "true") return;
          link.dataset.magneticReady = "true";

          link.addEventListener("pointermove", (event) => {
            if (event.pointerType !== "mouse") return;
            const bounds = link.getBoundingClientRect();
            const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 6;
            const y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 6;
            link.style.setProperty("--magnetic-x", `${x.toFixed(2)}px`);
            link.style.setProperty("--magnetic-y", `${y.toFixed(2)}px`);
          });

          link.addEventListener("pointerleave", () => {
            link.style.setProperty("--magnetic-x", "0px");
            link.style.setProperty("--magnetic-y", "0px");
          });
        });
      };

      const initInteractiveCards = () => {
        document.querySelectorAll("[data-interactive-card]").forEach((card) => {
          if (card.dataset.interactiveReady === "true") return;
          card.dataset.interactiveReady = "true";

          card.addEventListener("pointermove", (event) => {
            if (event.pointerType !== "mouse") return;
            const bounds = card.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - 0.5;
            const y = (event.clientY - bounds.top) / bounds.height - 0.5;
            const responsiveCurve = (value) => Math.sign(value) * Math.sqrt(Math.abs(value * 2));
            card.style.setProperty("--card-rotate-x", `${(-responsiveCurve(y) * 5).toFixed(2)}deg`);
            card.style.setProperty("--card-rotate-y", `${(responsiveCurve(x) * 5).toFixed(2)}deg`);
          });

          card.addEventListener("pointerleave", () => {
            card.style.setProperty("--card-rotate-x", "0deg");
            card.style.setProperty("--card-rotate-y", "0deg");
          });
        });
      };

      const initBinaryBackgrounds = () => {
        const fields = getBinaryFields();
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        fields.forEach((field) => {
          if (field.dataset.binaryReady === "true") return;
          field.dataset.binaryReady = "true";

          const update = () => {
            let binaryText = "";
            for (let i = 0; i < 1000; i++) {
              binaryText += Math.floor(Math.random() * 2).toString();
            }
            field.innerHTML = [...binaryText].map((digit) =>
              `<span class="binary-digit" data-value="${digit}">${digit}</span>`
            ).join("");
            window.requestAnimationFrame(() => {
              if (!field.isConnected) return;
              binaryDigitPositions.set(field, [...field.querySelectorAll(".binary-digit")].map((digit) => {
                const bounds = digit.getBoundingClientRect();
                return {
                  digit,
                  x: bounds.left + bounds.width / 2,
                  y: bounds.top + bounds.height / 2,
                };
              }));
            });
          };

          update();
          if (!reducedMotion) {
            const interval = window.setInterval(() => {
              if (!field.isConnected) {
                window.clearInterval(interval);
                return;
              }
              update();
            }, 300);
          }
        });

        if (binaryAnimationState.initialized || reducedMotion) return;
        binaryAnimationState.initialized = true;

        window.addEventListener("pointermove", (event) => {
          if (binaryAnimationState.frame) return;
          binaryAnimationState.frame = window.requestAnimationFrame(() => {
            getBinaryFields().forEach((field) => {
              const positions = binaryDigitPositions.get(field) || [];
              const closestDigits = [];

              positions.forEach((entry) => {
                const distance = Math.hypot(entry.x - event.clientX, entry.y - event.clientY);
                if (distance >= 45) return;

                const candidate = { digit: entry.digit, distance };
                let insertAt = closestDigits.findIndex((item) => item.distance > distance);
                if (insertAt === -1) insertAt = closestDigits.length;
                closestDigits.splice(insertAt, 0, candidate);
                if (closestDigits.length > 5) closestDigits.pop();
              });

              closestDigits.forEach(({ digit }) => {
                digit.textContent = "1";
                digit.classList.add("binary-digit-lit");
                const litUntil = Date.now() + 240;
                digit.dataset.binaryLitUntil = `${litUntil}`;
                window.setTimeout(() => {
                  if (!digit.isConnected || Number(digit.dataset.binaryLitUntil) !== litUntil) return;
                  digit.textContent = digit.dataset.value || "0";
                  digit.classList.remove("binary-digit-lit");
                  delete digit.dataset.binaryLitUntil;
                }, 240);
              });
            });
            binaryAnimationState.frame = 0;
          });
        }, { passive: true });

        const resetBinaryHighlights = () => {
          getBinaryFields().forEach((field) => {
            field.querySelectorAll(".binary-digit-lit").forEach((digit) => {
              digit.textContent = digit.dataset.value || "0";
              digit.classList.remove("binary-digit-lit");
            });
          });
        };

        window.addEventListener("pointerdown", () => {
          getBinaryFields().forEach((field) => field.classList.add("binary-pulse"));
          window.setTimeout(() => {
            getBinaryFields().forEach((field) => field.classList.remove("binary-pulse"));
          }, 260);
        }, { passive: true });

        window.addEventListener("pointerdown", (event) => {
          if (event.pointerType !== "mouse") return;

          for (let index = 0; index < 6; index += 1) {
            const glyph = document.createElement("span");
            const angle = (Math.PI * 2 * index) / 6 + (Math.random() - 0.5) * 0.35;
            const distance = 18 + Math.random() * 20;
            glyph.className = "binary-burst-glyph";
            glyph.textContent = Math.random() > 0.5 ? "1" : "0";
            glyph.style.left = `${event.clientX}px`;
            glyph.style.top = `${event.clientY}px`;
            glyph.style.setProperty("--burst-x", `${Math.cos(angle) * distance}px`);
            glyph.style.setProperty("--burst-y", `${Math.sin(angle) * distance}px`);
            document.body.appendChild(glyph);
            window.setTimeout(() => glyph.remove(), 650);
          }
        }, { passive: true });

        window.addEventListener("blur", resetBinaryHighlights);
        document.addEventListener("pointerleave", resetBinaryHighlights);
      };

      initInteractiveCards();
      initRevealSections();
      initMagneticLinks();
      initBinaryBackgrounds();
      document.addEventListener("astro:after-swap", initRevealSections);
      document.addEventListener("astro:after-swap", initMagneticLinks);
      document.addEventListener("astro:after-swap", initInteractiveCards);
      document.addEventListener("astro:after-swap", initBinaryBackgrounds);
    </script>
  </body>
</html>
