---
import BaseHead from "@/components/BaseHead.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { SITE_TITLE } from "@/consts";
import { getLang, useTranslations } from "@/i18n";

type Props = {
  title?: string;
  description?: string;
  /** Keep the page out of search results (error pages). */
  noindex?: boolean;
};

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const {
  title = SITE_TITLE,
  description = t("meta.description"),
  noindex = false,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
  </head>

  <body class="bg-black text-white tracking-wide">
    <a href="#main" class="skip-link">{t("nav.skip")}</a>
    <header class="fixed top-0 inset-x-0 z-[9999]"><Navbar /></header>
    <main id="main" class="pt-20" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import "@/scripts/app";
    </script>
  </body>
</html>
