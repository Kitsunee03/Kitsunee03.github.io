---
import { SITE_TITLE, EMAIL, NAV_LINKS, SOCIAL_LINKS } from "@/consts";

const today = new Date();
---

<div class="relative h-20 overflow-hidden" aria-hidden="true">
  <canvas
    class="glyph-canvas absolute inset-0 h-full w-full"
    data-visual="glyph-field"
    data-visual-options={JSON.stringify({ base: 0.05 })}></canvas>
</div>
<footer
  id="footer"
  class="w-full bg-[var(--bg-secondary)] border-t border-[var(--border-color)]"
>
  <div class="max-w-6xl mx-auto px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Navigation -->
      <div>
        <h3 class="text-lg mb-4 text-[var(--text-secondary)]">
          <span>&lt;</span>
          <span data-i18n="footer.nav">Navigation</span>
          <span> /&gt;</span>
        </h3>
        <div class="flex flex-col gap-2">
          {NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="text-[var(--text-muted)] hover:text-white transition-colors w-fit"
            >
              <span aria-hidden="true">&gt; </span>
              <span data-i18n={link.i18nKey}>{link.title}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Social -->
      <div>
        <h3 class="text-lg mb-4 text-[var(--text-secondary)]">
          <span>&lt;</span>
          <span data-i18n="footer.social">Social</span>
          <span> /&gt;</span>
        </h3>
        <div class="flex flex-col gap-2">
          <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" class="text-[var(--text-muted)] hover:text-white transition-colors w-fit">&gt; GitHub</a>
          <a href={SOCIAL_LINKS.itchio} target="_blank" rel="noopener noreferrer" class="text-[var(--text-muted)] hover:text-white transition-colors w-fit">&gt; Itch.io</a>
          <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" class="text-[var(--text-muted)] hover:text-white transition-colors w-fit">&gt; LinkedIn</a>
          <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" class="text-[var(--text-muted)] hover:text-white transition-colors w-fit">&gt; Instagram</a>
          <a href={SOCIAL_LINKS.tiktok} target="_blank" rel="noopener noreferrer" class="text-[var(--text-muted)] hover:text-white transition-colors w-fit">&gt; TikTok</a>
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg mb-4 text-[var(--text-secondary)]">
          <span>&lt;</span>
          <span data-i18n="footer.contact">Contact</span>
          <span> /&gt;</span>
        </h3>
        <button
          id="footer-copy-email"
          class="text-[var(--text-muted)] hover:text-white transition-colors break-all cursor-pointer text-left"
          data-email={EMAIL}
          title="Click to copy email"
          data-i18n-attr="title:footer.copyTitle"
        >
          {EMAIL}
        </button>
        <p id="footer-copy-feedback" class="text-xs text-[var(--text-muted)] h-4 mt-1" role="status"></p>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-6 border-t border-[var(--border-color)] text-center">
      <div class="text-[var(--text-muted)] text-sm">
        <span>&copy; {today.getFullYear()} {SITE_TITLE}. </span>
        <span data-i18n="footer.copyright">All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>

<script>
  function initFooterCopy() {
    const btn = document.getElementById("footer-copy-email");
    const feedback = document.getElementById("footer-copy-feedback");
    if (!btn) return;
    btn.addEventListener("click", async () => {
      const email = btn.getAttribute("data-email") || "";
      try {
        await navigator.clipboard.writeText(email);
        if (feedback) {
          feedback.textContent = window.__i18n ? window.__i18n.t("footer.copySuccess") : "✓ Copied!";
          setTimeout(() => { feedback.textContent = ""; }, 2000);
        }
      } catch {
        if (feedback) {
          feedback.textContent = window.__i18n ? window.__i18n.t("footer.copyError") : "Failed to copy";
        }
      }
    });
  }
  initFooterCopy();
  document.addEventListener("astro:after-swap", initFooterCopy);
</script>
