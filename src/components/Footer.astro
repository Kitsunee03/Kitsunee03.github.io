---
import { getLang, localizePath, useTranslations } from "@/i18n";
import { SITE_TITLE, EMAIL, NAV_LINKS, SOCIAL_LINKS } from "@/consts";

// Evaluated at build time: the signature shows when the site was built.
const today = new Date();
const buildDate = today.toISOString().slice(0, 10);
// Shown as DD-MM-YYYY; the machine-readable value stays ISO.
const buildLabel = buildDate.split("-").reverse().join("-");
const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<div class="relative h-20 overflow-hidden" aria-hidden="true">
  <canvas
    class="glyph-canvas absolute inset-0 h-full w-full"
    data-visual="glyph-field"
    data-visual-options={JSON.stringify({ base: 0.05 })}></canvas>
</div>
<footer
  id="footer"
  class="w-full bg-[var(--bg-secondary)] border-t border-[var(--border-color)]"
>
  <div class="max-w-6xl mx-auto px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Navigation -->
      <div>
        <h3 class="text-lg mb-4 text-[var(--text-secondary)]">
          <span>&lt;</span>
          <span>{t("footer.nav")}</span>
          <span> /&gt;</span>
        </h3>
        <div class="flex flex-col gap-2">
          {
            NAV_LINKS.map((link) => (
              <a
                href={localizePath(link.href, lang)}
                class="text-[var(--text-muted)] hover:text-white transition-colors w-fit"
              >
                <span aria-hidden="true">&gt; </span>
                <span>{t(link.i18nKey)}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Social -->
      <div>
        <h3 class="text-lg mb-4 text-[var(--text-secondary)]">
          <span>&lt;</span>
          <span>{t("footer.social")}</span>
          <span> /&gt;</span>
        </h3>
        <div class="flex flex-col gap-2">
          <a
            href={SOCIAL_LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-muted)] hover:text-white transition-colors w-fit"
            >&gt; GitHub</a
          >
          <a
            href={SOCIAL_LINKS.itchio}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-muted)] hover:text-white transition-colors w-fit"
            >&gt; Itch.io</a
          >
          <a
            href={SOCIAL_LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-muted)] hover:text-white transition-colors w-fit"
            >&gt; LinkedIn</a
          >
          <a
            href={SOCIAL_LINKS.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-muted)] hover:text-white transition-colors w-fit"
            >&gt; Instagram</a
          >
          <a
            href={SOCIAL_LINKS.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-muted)] hover:text-white transition-colors w-fit"
            >&gt; TikTok</a
          >
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg mb-4 text-[var(--text-secondary)]">
          <span>&lt;</span>
          <span>{t("footer.contact")}</span>
          <span> /&gt;</span>
        </h3>
        <button
          type="button"
          class="text-[var(--text-muted)] hover:text-white transition-colors break-all cursor-pointer text-left"
          title={t("footer.copyTitle")}
          data-copy={EMAIL}
          data-copy-success={t("footer.copySuccess")}
          data-copy-error={t("footer.copyError")}
          data-copy-feedback="footer-copy-feedback"
        >
          {EMAIL}
        </button>
        <p
          id="footer-copy-feedback"
          class="text-xs text-[var(--text-muted)] h-4 mt-1"
          role="status"
        >
        </p>
      </div>
    </div>

    <!-- Copyright -->
    <div
      class="mt-10 pt-6 border-t border-[var(--border-color)] flex flex-col items-center gap-2 text-center"
    >
      <div class="text-[var(--text-muted)] text-sm">
        <span>&copy; {today.getFullYear()} {SITE_TITLE}. </span>
        <span>{t("footer.copyright")}</span>
      </div>
      <p class="footer-signature text-xs text-[var(--text-muted)]">
        <span class="text-[var(--signal)]" aria-hidden="true">&gt;</span>
        <span>{t("footer.build")}</span>
        <time datetime={buildDate}>{buildLabel}</time>
        <span class="footer-caret" aria-hidden="true">_</span>
      </p>
    </div>
  </div>
</footer>
