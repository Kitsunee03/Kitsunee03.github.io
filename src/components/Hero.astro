---
import { FULL_NAME, PROFESSIONAL_TITLE, QUOTE } from "@/consts";
---

<section
  class="hero relative isolate min-h-[calc(100svh-5rem)] w-full grid grid-cols-1 md:grid-cols-2 gap-4 items-center overflow-hidden"
  id="hero"
>
  <canvas
    class="glyph-canvas absolute inset-0 -z-10 h-full w-full"
    data-visual="glyph-field"
    aria-hidden="true"></canvas>
  <div class="grid place-items-center">
    <div
      class="text-center md:text-left space-y-4 px-6 py-16 md:pl-16 md:pr-4"
    >
      <h1
        class="font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl"
        aria-label={FULL_NAME}
      >
        <span aria-hidden="true">{`<${FULL_NAME} />`}</span>
      </h1>
      <p
        class="font-display text-xl md:text-2xl text-[var(--text-secondary)]"
        data-i18n="hero.subtitle"
      >
        {PROFESSIONAL_TITLE}
      </p>
      <p
        class="text-sm md:text-base text-[var(--text-muted)] max-w-lg pt-2 mx-auto md:mx-0"
        data-i18n="hero.quote"
      >
        {QUOTE}
      </p>
      <div class="pt-6 flex gap-4 justify-center md:justify-start flex-wrap">
        <a
          href="/projects"
          class="magnetic-link border border-white px-6 py-2.5 rounded-md hover:bg-white hover:text-black transition-all text-sm"
          data-magnetic-link
          data-i18n="hero.cta.projects"
        >
          View Projects
        </a>
        <a
          href="/contact"
          class="magnetic-link border border-[var(--border-color)] px-6 py-2.5 rounded-md hover:border-white transition-all text-sm text-[var(--text-secondary)] hover:text-white"
          data-magnetic-link
          data-i18n="hero.cta.contact"
        >
          Contact Me
        </a>
      </div>
    </div>
  </div>
  <div class="hidden md:flex justify-center items-center">
    <img
      src="/images/evangelionAscii.webp"
      alt=""
      width="455"
      height="465"
      decoding="async"
      class="ascii-portrait brightness-200 w-full max-w-xl scale-110 invert"
    />
  </div>
</section>
