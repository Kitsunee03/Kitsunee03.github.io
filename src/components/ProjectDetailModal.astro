---
import { Icon } from "astro-icon/components";
import { render, type CollectionEntry } from "astro:content";

type Props = {
  projects: CollectionEntry<"projects">[];
};

const { projects } = Astro.props;
const getYoutubeThumbnail = (url: string) => {
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([^?&/]+)/);
  return match ? `https://img.youtube.com/vi/${match[1]}/hqdefault.jpg` : undefined;
};
const getLinkIcon = (link: { kind?: string; url: string }) => {
  const kind = link.kind?.toLowerCase();
  if (kind === "itch" || link.url.includes("itch.io")) return "simple-icons:itchdotio";
  if (kind === "youtube" || link.url.includes("youtu.be") || link.url.includes("youtube.com")) return "simple-icons:youtube";
  if (kind === "github" || link.url.includes("github.com")) return "simple-icons:github";
  if (kind === "linktree" || link.url.includes("linktr.ee")) return "mdi:link-variant";
  return "mdi:link-variant";
};
const renderedProjects = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    const links = project.data.links?.length
      ? project.data.links.map((link) => ({
          ...link,
          thumbnail: link.thumbnail || getYoutubeThumbnail(link.url),
        }))
      : project.data.link
        ? [{ label: "Visit on itch.io", url: project.data.link, kind: "itch", thumbnail: undefined }]
        : [];
    const allLinks = project.data.link && project.data.links?.length
      ? [...links, { label: "Visit on itch.io", url: project.data.link, kind: "itch", thumbnail: undefined }]
      : links;

    return { project, Content, links: allLinks };
  }),
);
---

<div
  id="project-detail-modal"
  class="fixed inset-0 z-[10000] hidden items-center justify-center overflow-hidden overscroll-contain bg-black/85 p-3 backdrop-blur-sm opacity-0 transition-opacity duration-300 md:p-6"
  aria-hidden="true"
>
  <div
    class="project-detail-dialog relative flex max-h-[calc(100dvh-1.5rem)] w-full max-w-6xl translate-y-4 flex-col overflow-hidden rounded-lg border border-[var(--border-hover)] bg-[var(--bg-secondary)] shadow-2xl transition-transform duration-300 md:max-h-[calc(100dvh-3rem)]"
    role="dialog"
    aria-modal="true"
    aria-labelledby="project-detail-title"
    tabindex="-1"
  >
    <div class="flex shrink-0 items-center justify-between border-b border-[var(--border-color)] bg-[var(--bg-card)] px-4 py-3 md:px-6">
      <span class="text-xs uppercase tracking-[0.2em] text-[var(--text-muted)]">Project log</span>
      <button
        type="button"
        id="project-detail-close"
        class="grid h-9 w-9 place-items-center rounded-md border border-white/20 text-white transition-colors hover:border-white hover:bg-white hover:text-black focus:outline-none focus:ring-2 focus:ring-white"
        aria-label="Close project details"
        data-i18n-attr="aria-label:projects.modal.close"
      >
        <Icon name="mdi:close" class="h-5 w-5" />
      </button>
    </div>

    {renderedProjects.map(({ project, Content, links }) => (
      <article class="project-detail-view hidden min-h-0 overflow-y-auto overscroll-contain" data-project-id={project.id}>
        <div class="grid min-h-full grid-cols-1 lg:grid-cols-[minmax(0,1fr)_18rem]">
          <div class="min-w-0 space-y-10 p-5 md:p-10">
            <header class="space-y-5 border-b border-[var(--border-color)] pb-8">
              <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.2em] text-[var(--text-muted)]">
                <span>{project.data.engine}</span>
                <span aria-hidden="true">/</span>
                <span>Devlog</span>
              </div>
              <h2 class="text-3xl font-bold text-white md:text-4xl" data-project-title>{project.data.title}</h2>
              <p class="project-detail-lead max-w-3xl text-base leading-relaxed text-[var(--text-secondary)]">{project.data.description}</p>
              <div class="flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <span class="rounded-full bg-white/10 px-2.5 py-1 text-xs text-[var(--text-secondary)]">{tag}</span>
                ))}
              </div>
            </header>

            <figure class="project-detail-media w-full overflow-hidden rounded-lg border border-[var(--border-color)] bg-[var(--bg-tertiary)] p-3">
              <img src={project.data.hero || project.data.image} alt={`${project.data.title} gameplay`} class="block h-auto w-full object-contain" loading="lazy" />
            </figure>

            <div class="project-detail-prose max-w-3xl">
              <Content />
            </div>

            <div class="project-detail-facts space-y-8">
              <section class="space-y-3">
                <h3 class="project-detail-label" data-i18n="projects.modal.overview">Overview</h3>
                <p class="leading-relaxed text-[var(--text-secondary)]">{project.data.overview || project.data.description}</p>
              </section>

              {project.data.contribution && (
                <section class="space-y-3 border-l border-white/30 pl-4">
                  <h3 class="project-detail-label" data-i18n="projects.modal.contribution">My contribution</h3>
                  <ul class="space-y-2 text-sm leading-relaxed text-[var(--text-secondary)]">
                    {project.data.contribution.map((item) => <li>{item}</li>)}
                  </ul>
                </section>
              )}

              {project.data.highlights && (
                <section class="space-y-3">
                  <h3 class="project-detail-label" data-i18n="projects.modal.highlights">Highlights</h3>
                  <ul class="grid gap-2 text-sm leading-relaxed text-[var(--text-secondary)] sm:grid-cols-2">
                    {project.data.highlights.map((item) => <li class="border border-[var(--border-color)] bg-[var(--bg-card)] p-3">{item}</li>)}
                  </ul>
                </section>
              )}

              <div class="grid gap-6 sm:grid-cols-2">
                {project.data.technologies && (
                  <section class="space-y-3">
                    <h3 class="project-detail-label" data-i18n="projects.modal.technologies">Technologies</h3>
                    <ul class="space-y-1 text-sm text-[var(--text-secondary)]">{project.data.technologies.map((item) => <li>{item}</li>)}</ul>
                  </section>
                )}
                {project.data.controls && (
                  <section class="space-y-3">
                    <h3 class="project-detail-label" data-i18n="projects.modal.controls">Controls</h3>
                    <ul class="space-y-1 text-sm text-[var(--text-secondary)]">{project.data.controls.map((item) => <li>{item}</li>)}</ul>
                  </section>
                )}
              </div>

              {project.data.challenges && (
                <section class="space-y-3">
                  <h3 class="project-detail-label" data-i18n="projects.modal.challenges">Challenges</h3>
                  <ul class="space-y-2 text-sm leading-relaxed text-[var(--text-secondary)]">{project.data.challenges.map((item) => <li>{item}</li>)}</ul>
                </section>
              )}

              {project.data.technicalDecisions && (
                <section class="space-y-3">
                  <h3 class="project-detail-label" data-i18n="projects.modal.decisions">Technical decisions</h3>
                  <ul class="space-y-2 text-sm leading-relaxed text-[var(--text-secondary)]">{project.data.technicalDecisions.map((item) => <li>{item}</li>)}</ul>
                </section>
              )}
            </div>
          </div>

          <aside class="border-t border-[var(--border-color)] bg-[var(--bg-card)] p-5 lg:border-l lg:border-t-0 lg:p-7">
            <div class="space-y-8 lg:sticky lg:top-0">
              <div class="space-y-3">
                <h3 class="project-detail-label">Links</h3>
                <div class="flex flex-col gap-2">
                  {links.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer" class:list={["group border border-[var(--border-color)] text-sm text-[var(--text-secondary)] transition-colors hover:border-white hover:bg-white hover:text-black", link.thumbnail ? "overflow-hidden" : "inline-flex items-center justify-between gap-3 px-3 py-2.5"]}>
                      {link.thumbnail && <img src={link.thumbnail} alt={link.alt || link.label} class="aspect-video w-full object-cover" loading="lazy" />}
                      <span class:list={["flex items-center justify-between gap-3", link.thumbnail ? "px-3 py-2.5" : ""]}>
                        <span class="flex min-w-0 items-center gap-2">
                          <Icon name={getLinkIcon(link)} class="h-4 w-4 shrink-0" />
                          <span>{link.label}</span>
                        </span>
                        <Icon name="mdi:arrow-top-right" class="h-4 w-4 shrink-0" />
                      </span>
                    </a>
                  ))}
                </div>
              </div>
              {project.data.previews?.length ? (
                <div class="space-y-3">
                  <h3 class="project-detail-label">Preview</h3>
                  <div class="grid gap-3">
                    {project.data.previews.map((preview) => (
                      <figure class="overflow-hidden rounded border border-[var(--border-color)] bg-[var(--bg-tertiary)]">
                        <div class="flex min-h-24 items-center justify-center p-2">
                          <img src={preview.src} alt={preview.alt} class="max-h-72 w-auto max-w-full object-contain" loading="lazy" />
                        </div>
                        {preview.caption && <figcaption class="border-t border-[var(--border-color)] px-3 py-2 text-xs text-[var(--text-muted)]">{preview.caption}</figcaption>}
                      </figure>
                    ))}
                  </div>
                </div>
              ) : project.data.gif ? <img src={project.data.gif} alt="" class="w-full rounded border border-[var(--border-color)] object-contain" loading="lazy" /> : null}
            </div>
          </aside>
        </div>
      </article>
    ))}
  </div>
</div>

<script>
  let modal: HTMLElement | null = null;
  let dialog: HTMLElement | null = null;
  let lastTrigger: HTMLElement | null = null;
  let closeTimer = 0;
  let initialized = false;

  const refreshElements = () => {
    modal = document.getElementById("project-detail-modal");
    dialog = modal?.querySelector<HTMLElement>(".project-detail-dialog") || null;
  };

  const resetModal = () => {
    window.clearTimeout(closeTimer);
    modal?.classList.add("hidden");
    modal?.classList.remove("flex", "opacity-100");
    dialog?.classList.add("translate-y-4");
    dialog?.classList.remove("translate-y-0");
    modal?.setAttribute("aria-hidden", "true");
    document.body.classList.remove("project-modal-open");
    lastTrigger = null;
  };

  const closeModal = (restoreFocus = true) => {
    if (!modal || !dialog || modal.getAttribute("aria-hidden") !== "false") return;
    modal.classList.remove("opacity-100");
    dialog.classList.remove("translate-y-0");
    dialog.classList.add("translate-y-4");
    closeTimer = window.setTimeout(() => {
      const triggerToRestore = lastTrigger;
      resetModal();
      if (restoreFocus) triggerToRestore?.focus();
    }, 200);
  };

  const openModal = (projectId: string, trigger: HTMLElement) => {
    refreshElements();
    if (!modal || !dialog) return;
    const project = Array.from(modal.querySelectorAll<HTMLElement>(".project-detail-view"))
      .find((view) => view.dataset.projectId === projectId);
    if (!project) return;

    window.clearTimeout(closeTimer);
    lastTrigger = trigger;
    modal.querySelectorAll<HTMLElement>(".project-detail-view").forEach((view) => view.classList.add("hidden"));
    project.classList.remove("hidden");
    project.scrollTop = 0;
    const title = project.querySelector<HTMLElement>("[data-project-title]");
    if (title) {
      title.id = "project-detail-title";
      dialog.setAttribute("aria-labelledby", title.id);
    }
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("project-modal-open");
    requestAnimationFrame(() => {
      modal?.classList.add("opacity-100");
      dialog?.classList.remove("translate-y-4");
      dialog?.classList.add("translate-y-0");
      dialog?.focus();
    });
  };

  const initProjectModal = () => {
    refreshElements();
    if (initialized) {
      resetModal();
      return;
    }
    initialized = true;
    resetModal();

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const trigger = target.closest<HTMLElement>("[data-project-trigger]");
      if (trigger) {
        event.preventDefault();
        const projectId = trigger.dataset.projectId;
        if (projectId) openModal(projectId, trigger);
        return;
      }
      if (target === modal || target.closest("#project-detail-close")) closeModal();
    });

    document.addEventListener("keydown", (event) => {
      if (modal?.getAttribute("aria-hidden") !== "false" || !dialog) return;
      if (event.key === "Escape") {
        closeModal();
        return;
      }
      if (event.key !== "Tab") return;
      const focusable = dialog.querySelectorAll<HTMLElement>("button:not([disabled]), a[href], [tabindex]:not([tabindex=\"-1\"])");
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  };

  initProjectModal();
  document.addEventListener("astro:page-load", initProjectModal);
  document.addEventListener("astro:after-swap", () => {
    refreshElements();
    resetModal();
  });
</script>
