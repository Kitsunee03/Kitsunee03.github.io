---
/**
 * Decorative ASCII lance (generated by src/lib/ascii-lance.ts).
 * The lance marks the way to contact: it opens every contact block, flanks
 * the contact page and lies broken on the 404. Hidden from assistive tech.
 * Inside a revealed section it draws itself, then a pulse of light runs
 * from the butt to the points every few seconds.
 */
import { asciiLance } from "@/lib/ascii-lance";

type Props = {
  length?: number;
  /** Characters per twist; defaults suit each orientation. */
  twist?: number;
  orientation?: "horizontal" | "vertical";
  /** Where the points face: right/left (horizontal), down/up (vertical). */
  point?: "right" | "left" | "down" | "up";
  tone?: "muted" | "signal";
  /** Snapped in two (used by the 404 page). */
  broken?: boolean;
  class?: string;
};

const {
  length = 96,
  twist,
  orientation = "horizontal",
  point = orientation === "horizontal" ? "right" : "down",
  tone = "muted",
  broken = false,
  class: className,
} = Astro.props;

const art = asciiLance({ orientation, length, twist, point, broken });
---

<pre
  class:list={["ascii-lance", className]}
  data-orientation={orientation}
  data-point={point}
  data-tone={tone}
  aria-hidden="true">{art}</pre>
