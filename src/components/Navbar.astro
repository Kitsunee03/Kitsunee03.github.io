---
import { SITE_TITLE, NAV_LINKS as links } from "@/consts";
---

<nav class="w-full py-4 px-4 bg-black/90 backdrop-blur-sm" aria-label="Main">
  <div
    class="max-w-6xl mx-auto flex items-center justify-between px-4 md:px-8"
  >
    <a
      href="/"
      id="logo"
      class="nav-logo pt-2 pb-1 grid place-items-center select-none leading-none px-4"
    >
      {SITE_TITLE}
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1">
      <span class="text-[var(--text-muted)]" aria-hidden="true">/</span>
      {
        links.map((link, i) => {
          const href = link.href;
          const pathname = Astro.url.pathname.replace(
            import.meta.env.BASE_URL,
            "",
          );
          const isActive =
            href === "/" 
              ? pathname === "" || pathname === "/" 
              : pathname.startsWith(href.slice(1));
          return (
            <>
              <a
                class:list={[
                  "magnetic-link hover:bg-white hover:text-black transition-all ease-in-out px-3 py-1 rounded-md",
                  { "bg-white text-black": isActive },
                ]}
                href={href}
                aria-current={isActive ? "page" : undefined}
                data-magnetic-link
                data-i18n={link.i18nKey}
              >
                {link.title}
              </a>
              <span class="text-[var(--text-muted)]" aria-hidden="true">/</span>
            </>
          );
        })
      }
      <button
        type="button"
        data-lang-toggle
        class="ml-2 flex items-center gap-2 px-2 py-1 rounded-md border border-[var(--border-color)] hover:border-white hover:bg-white/10 transition-all text-xs"
        aria-label="Change language"
        title="Change language"
        data-i18n-attr="aria-label:nav.language.aria;title:nav.language.title"
      >
        <span class="lang-option text-white" data-lang="en">EN</span>
        <span class="text-[var(--text-muted)]" aria-hidden="true">/</span>
        <span class="lang-option text-[var(--text-muted)]" data-lang="es">ES</span>
      </button>
    </div>

    <!-- Mobile hamburger -->
    <button
      type="button"
      id="mobile-menu-btn"
      class="mobile-menu-btn md:hidden flex flex-col gap-1.5 p-2 hover:bg-white/10 transition-colors"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-i18n-attr="aria-label:nav.menu"
    >
      <span class="block w-6 h-0.5 bg-white transition-transform"></span>
      <span class="block w-6 h-0.5 bg-white transition-opacity"></span>
      <span class="block w-6 h-0.5 bg-white transition-transform"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden max-w-6xl mx-auto mt-4 px-4 pb-2 border-t border-[var(--border-color)]"
  >
    <div class="flex flex-col gap-2 pt-4">
      {
        links.map((link) => {
          const href = link.href;
          const pathname = Astro.url.pathname.replace(
            import.meta.env.BASE_URL,
            "",
          );
          const isActive =
            href === "/"
              ? pathname === "" || pathname === "/"
              : pathname.startsWith(href.slice(1));
          return (
            <a
              class:list={[
                "magnetic-link hover:bg-white hover:text-black transition-all ease-in-out px-3 py-2 text-lg rounded-md",
                { "bg-white text-black": isActive },
              ]}
              href={href}
              aria-current={isActive ? "page" : undefined}
              data-magnetic-link
              data-i18n={link.i18nKey}
            >
              {link.title}
            </a>
          );
        })
      }
      <button
        type="button"
        data-lang-toggle
        class="mt-2 w-fit flex items-center gap-2 px-3 py-2 rounded-md border border-[var(--border-color)] hover:border-white hover:bg-white/10 transition-all text-sm"
        aria-label="Change language"
        title="Change language"
        data-i18n-attr="aria-label:nav.language.aria;title:nav.language.title"
      >
        <span class="lang-option text-white" data-lang="en">EN</span>
        <span class="text-[var(--text-muted)]" aria-hidden="true">/</span>
        <span class="lang-option text-[var(--text-muted)]" data-lang="es">ES</span>
      </button>
    </div>
  </div>
</nav>

<script>
  function updateLangToggles() {
    const api = window.__i18n;
    if (!api) return;
    const current = api.getLang();
    document.querySelectorAll("[data-lang-toggle]").forEach((btn) => {
      btn.querySelectorAll(".lang-option").forEach((option) => {
        const isActive = option.getAttribute("data-lang") === current;
        option.classList.toggle("text-white", isActive);
        option.classList.toggle("text-[var(--text-muted)]", !isActive);
      });
    });
  }

  function initLangToggles() {
    const api = window.__i18n;
    if (!api) return;
    document.querySelectorAll("[data-lang-toggle]").forEach((btn) => {
      if ((btn as HTMLElement).dataset.bound === "true") return;
      (btn as HTMLElement).dataset.bound = "true";
      btn.addEventListener("click", () => {
        const current = api.getLang();
        const next = current === "en" ? "es" : "en";
        const apply = () => {
          api.setLang(next);
          updateLangToggles();
        };
        if (document.startViewTransition) {
          document.startViewTransition(() => apply());
        } else {
          apply();
        }
      });
    });
    updateLangToggles();
  }

  const onI18nReady = () => {
    initLangToggles();
    updateLangToggles();
  };

  if (window.__i18n) {
    onI18nReady();
  } else {
    window.addEventListener("i18n:ready", onI18nReady, { once: true });
  }

  document.addEventListener("DOMContentLoaded", initLangToggles);
  document.addEventListener("astro:after-swap", initLangToggles);
  window.addEventListener("i18n:changed", updateLangToggles);
</script>
