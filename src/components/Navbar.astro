---
import { getLang, localizePath, useTranslations } from "@/i18n";
import LangToggle from "./LangToggle.astro";
import { SITE_TITLE, NAV_LINKS } from "@/consts";

const lang = getLang(Astro.url);
const t = useTranslations(lang);

// Path without the language prefix, used to mark the current page.
const current =
  localizePath(Astro.url.pathname, "en").replace(/\/$/, "") || "/";
const links = NAV_LINKS.map((link) => ({
  label: t(link.i18nKey),
  href: localizePath(link.href, lang),
  active: link.href === "/" ? current === "/" : current.startsWith(link.href),
}));
---

<nav
  class="w-full py-4 px-4 bg-black/90 backdrop-blur-sm"
  aria-label={t("nav.aria")}
>
  <div class="max-w-6xl mx-auto flex items-center justify-between px-4 md:px-8">
    <a
      href={localizePath("/", lang)}
      id="logo"
      class="nav-logo pt-2 pb-1 grid place-items-center select-none leading-none px-4"
    >
      {SITE_TITLE}
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1">
      <span class="text-[var(--text-muted)]" aria-hidden="true">/</span>
      {
        links.map((link) => (
          <>
            <a
              class:list={[
                "magnetic-link hover:bg-white hover:text-black transition-all ease-in-out px-3 py-1 rounded-md",
                { "bg-white text-black": link.active },
              ]}
              href={link.href}
              aria-current={link.active ? "page" : undefined}
              data-magnetic-link
            >
              {link.label}
            </a>
            <span class="text-[var(--text-muted)]" aria-hidden="true">
              /
            </span>
          </>
        ))
      }
      <div class="ml-2"><LangToggle size="sm" /></div>
    </div>

    <!-- Mobile hamburger -->
    <button
      type="button"
      id="mobile-menu-btn"
      class="mobile-menu-btn md:hidden flex flex-col gap-1.5 p-2 hover:bg-white/10 transition-colors"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t("nav.menu")}
    >
      <span class="block w-6 h-0.5 bg-white transition-transform"></span>
      <span class="block w-6 h-0.5 bg-white transition-opacity"></span>
      <span class="block w-6 h-0.5 bg-white transition-transform"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden max-w-6xl mx-auto mt-4 px-4 pb-2 border-t border-[var(--border-color)]"
  >
    <div class="flex flex-col gap-2 pt-4">
      {
        links.map((link) => (
          <a
            class:list={[
              "magnetic-link hover:bg-white hover:text-black transition-all ease-in-out px-3 py-2 text-lg rounded-md",
              { "bg-white text-black": link.active },
            ]}
            href={link.href}
            aria-current={link.active ? "page" : undefined}
            data-magnetic-link
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-2"><LangToggle size="md" /></div>
    </div>
  </div>
</nav>
