---
/**
 * Language toggle: one control for the two options. The whole pill is a
 * link to the same page in the other language; the current language is
 * the highlighted label.
 */
import { getLang, switchLang, useTranslations, type Lang } from "@/i18n";

type Props = {
  size?: "sm" | "md";
};

const { size = "sm" } = Astro.props;
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const other: Lang = lang === "en" ? "es" : "en";
const labels: Array<{ code: Lang; label: string }> = [
  { code: "en", label: "EN" },
  { code: "es", label: "ES" },
];
---

<a
  href={switchLang(Astro.url, other)}
  hreflang={other}
  class:list={[
    "lang-toggle flex w-fit items-center gap-2 rounded-md border border-[var(--border-color)] hover:border-white hover:bg-white/10 transition-all",
    size === "sm" ? "px-2.5 py-1 text-xs" : "px-3 py-2 text-sm",
  ]}
  aria-label={t("nav.language.switch")}
  title={t("nav.language.switch")}
  data-lang-link={other}
>
  {
    labels.map((option, index) => (
      <>
        {index > 0 && (
          <span class="text-[var(--text-muted)]" aria-hidden="true">
            /
          </span>
        )}
        <span
          class="lang-option"
          aria-hidden="true"
          data-current={option.code === lang ? "" : undefined}
        >
          {option.label}
        </span>
      </>
    ))
  }
</a>
