---
import { Icon } from "astro-icon/components";
import VideoLoop from "./VideoLoop.astro";

type Props = {
  projectId: string;
  title: string;
  description: string;
  tags: string[];
  engine: string;
  image: string;
  video?: string;
};

const { projectId, title, description, tags, engine, image, video } = Astro.props;

const engineIcons: Record<string, string> = {
  Unity: "simple-icons:unity",
  "Unreal Engine": "simple-icons:unrealengine",
  Phaser: "mdi:gamepad-variant-outline",
  "C++": "devicon:cplusplus",
};
---

<article
  class="group relative interactive-card border border-[var(--border-color)] bg-[var(--bg-card)] hover:border-[var(--border-hover)] transition-all duration-300 overflow-hidden rounded-lg"
  data-interactive-card
>
  <div class="card-glare" aria-hidden="true"></div>
  <!-- Image -->
  <button
    type="button"
    class="relative block w-full overflow-hidden aspect-video bg-[var(--bg-tertiary)] text-left focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white"
    data-project-trigger
    data-project-id={projectId}
    aria-haspopup="dialog"
  >
    <!-- Placeholder (behind images, lowest z) -->
    <div
      class="absolute inset-0 flex items-center justify-center text-[var(--text-muted)] pointer-events-none z-0"
    >
      <Icon name="mdi:image-outline" class="w-12 h-12 opacity-30" />
    </div>
    <!-- Cover image -->
    <img
      src={image}
      alt={title}
      class="card-cover absolute inset-0 w-full h-full object-cover z-[1]"
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none'"
    />
    <!-- Preview loop: fetched and played only on hover or focus -->
    {
      video && (
        <VideoLoop
          src={video}
          class="card-video absolute inset-0 w-full h-full object-cover z-[2]"
          tabindex="-1"
          data-card-video
        />
      )
    }
    <!-- Engine badge -->
    <div
      class="absolute top-3 right-3 flex items-center gap-1.5 bg-black/80 backdrop-blur-sm px-2 py-1 text-xs rounded-md z-10"
    >
      <Icon
        name={engineIcons[engine] || "mdi:gamepad-variant"}
        class="w-3.5 h-3.5"
      />
      <span>{engine}</span>
    </div>
  </button>

  <!-- Content -->
  <div class="p-5 space-y-3">
    <h3 class="text-xl font-bold group-hover:text-white transition-colors">
      <button
        type="button"
        class="text-left focus:outline-none focus:underline focus:underline-offset-4"
        data-project-trigger
        data-project-id={projectId}
        aria-haspopup="dialog"
      >
        {title}
      </button>
    </h3>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <span class="bg-white/10 text-[var(--text-secondary)] text-xs px-2 py-0.5 rounded-full">
            {tag}
          </span>
        ))
      }
    </div>

    <div class="project-description">
      <p class="text-[var(--text-muted)] text-sm leading-relaxed">
        {description}
      </p>
    </div>

    <button
      type="button"
      class="inline-flex items-center gap-2 pt-1 text-sm text-[var(--text-secondary)] transition-colors hover:text-white focus:outline-none focus:underline focus:underline-offset-4"
      data-project-trigger
      data-project-id={projectId}
      aria-haspopup="dialog"
    >
      <span data-i18n="projects.view">View Details</span>
      <Icon name="mdi:arrow-right" class="h-4 w-4" />
    </button>
  </div>
</article>
