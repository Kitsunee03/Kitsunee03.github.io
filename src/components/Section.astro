---
type Props = {
  title: string;
  titleKey?: string;
  titleSuffix?: string;
  titleSuffixKey?: string;
  full_screen?: boolean;
  showTitle?: boolean;
  className?: string;
  variant?: "primary" | "secondary" | "tertiary";
};
const {
  title = "Section",
  titleKey = "",
  titleSuffix = "",
  titleSuffixKey = "",
  full_screen = false,
  showTitle = true,
  className = "",
  variant = "primary",
} = Astro.props;
const hasSuffix = Boolean(titleSuffix);
const sectionId = title
  .toLowerCase()
  .replace(/&/g, "and")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "");

const bgMap = {
  primary: "bg-[var(--bg-primary)]",
  secondary: "bg-[var(--bg-secondary)]",
  tertiary: "bg-[var(--bg-tertiary)]",
};
---

<section
  id={sectionId}
  class={`${full_screen ? "min-h-screen" : ""} px-4 py-16 w-full ${bgMap[variant]} ${className}`}
  data-reveal-section
>
  <div class="max-w-6xl mx-auto">
    {
      showTitle && (
        <div class="w-full grid place-items-center gap-3 mb-10">
          <span class="section-index" aria-hidden="true" />
          {hasSuffix ? (
            <h2 class="text-4xl md:text-5xl text-center">
              <span aria-hidden="true">&lt;</span>
              <span data-i18n={titleKey || undefined} data-decode>{title}</span>
              <span class="section-title-slash">/</span>
              <span
                class="section-title-suffix text-3xl md:text-4xl text-[var(--text-secondary)]"
                data-i18n={titleSuffixKey || undefined}
              >
                {titleSuffix}
              </span>
              <span class="section-title-trailing text-3xl md:text-4xl text-[var(--text-secondary)]">
                /
              </span>
              <span aria-hidden="true">&gt;</span>
            </h2>
          ) : (
            <h2 class="text-4xl md:text-5xl text-center">
              <span aria-hidden="true">&lt;</span>
              <span data-i18n={titleKey || undefined} data-decode>{title}</span>
              <span aria-hidden="true"> /&gt;</span>
            </h2>
          )}
        </div>
      )
    }
    <div class="w-full px-4">
      <slot />
    </div>
  </div>
</section>
