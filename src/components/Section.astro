---
type Props = {
  title: string;
  titleSuffix?: string;
  full_screen?: boolean;
  className?: string;
  variant?: "primary" | "secondary" | "tertiary";
};
const {
  title = "Section",
  titleSuffix = "",
  full_screen = false,
  className = "",
  variant = "primary",
} = Astro.props;
const hasSuffix = Boolean(titleSuffix);

const bgMap = {
  primary: "bg-[var(--bg-primary)]",
  secondary: "bg-[var(--bg-secondary)]",
  tertiary: "bg-[var(--bg-tertiary)]",
};
---

<section
  id={title.toLowerCase().replaceAll(" ", "")}
  class={`${full_screen ? "min-h-screen" : ""} px-4 py-16 w-screen !overflow-x-hidden ${bgMap[variant]} ${className}`}
>
  <div class="max-w-6xl mx-auto">
    <div class="w-full grid place-items-center mb-10">
      {hasSuffix ? (
        <h2 class="text-4xl md:text-5xl text-center">
          <span>{`<${title}`}</span>
          <span class="section-title-slash">/</span>
          <span class="section-title-suffix text-3xl md:text-4xl text-[var(--text-secondary)]">
            {titleSuffix}
          </span>
          <span class="section-title-trailing text-3xl md:text-4xl text-[var(--text-secondary)]">/</span>
          <span>{">"}</span>
        </h2>
      ) : (
        <h2 class="text-4xl md:text-5xl text-center">{`<${title} />`}</h2>
      )}
    </div>
    <div class="w-full px-4">
      <slot />
    </div>
  </div>
</section>
