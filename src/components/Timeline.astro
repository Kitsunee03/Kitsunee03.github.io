---
import { Icon } from "astro-icon/components";

type Props = {
  title: string;
  institution: string;
  period: string;
  description: string;
  titleKey?: string;
  institutionKey?: string;
  periodKey?: string;
  descriptionKey?: string;
  icon: string;
  mark?: string;
  logo?: string;
  link?: string;
  linkLabel?: string;
  linkLabelKey?: string;
  isLast?: boolean;
};

const {
  title,
  institution,
  period,
  description,
  titleKey = "",
  institutionKey = "",
  periodKey = "",
  descriptionKey = "",
  icon,
  mark = "",
  logo = "",
  link = "",
  linkLabel = "View reference",
  linkLabelKey = "",
  isLast = false,
} = Astro.props;
---

<div class="flex gap-4">
  <!-- Timeline line -->
  <div class="flex flex-col items-center">
    <div
      class="w-10 h-10 rounded-full bg-[var(--bg-card)] border border-[var(--border-color)] grid place-items-center shrink-0"
    >
      {
        logo ? (
          <img
            src={logo}
            alt=""
            class="h-6 w-6 object-contain"
            aria-hidden="true"
          />
        ) : mark ? (
          <span
            class="text-lg font-bold leading-none text-[var(--text-secondary)]"
            aria-hidden="true"
          >
            {mark}
          </span>
        ) : (
          <Icon
            name={icon}
            class="w-5 h-5 text-[var(--text-secondary)]"
            aria-hidden="true"
          />
        )
      }
    </div>
    {!isLast && <div class="w-px flex-1 bg-[var(--border-color)] mt-2" />}
  </div>

  <!-- Content -->
  <div class={`pb-8 ${isLast ? "" : ""}`}>
    <span
      class="text-xs text-[var(--text-muted)] tracking-wider"
      data-i18n={periodKey || undefined}
    >
      {period}
    </span>
    <h3 class="text-lg mt-1" data-i18n={titleKey || undefined}>{title}</h3>
    <p
      class="text-[var(--text-secondary)] text-sm mt-0.5"
      data-i18n={institutionKey || undefined}
    >
      {institution}
    </p>
    <p
      class="text-[var(--text-muted)] text-sm mt-2 leading-relaxed"
      data-i18n={descriptionKey || undefined}
    >
      {description}
    </p>
    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1.5 text-xs text-[var(--text-secondary)] underline decoration-[var(--border-hover)] underline-offset-4 transition-colors hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-primary)]"
        >
          <span data-i18n={linkLabelKey || undefined}>{linkLabel}</span>
          <Icon name="mdi:open-in-new" class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      )
    }
  </div>
</div>
