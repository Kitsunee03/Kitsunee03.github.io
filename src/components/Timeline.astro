---
import { getLang, useTranslations } from "@/i18n";
import { Icon } from "astro-icon/components";

type Props = {
  /** Dictionary prefix holding title, institution, period and description. */
  entryKey: string;
  icon: string;
  mark?: string;
  logo?: string;
  link?: string;
  linkLabelKey?: string;
  isLast?: boolean;
  /** Ongoing entry: the node keeps a slow signal pulse. */
  current?: boolean;
};

const {
  entryKey,
  icon,
  mark = "",
  logo = "",
  link = "",
  linkLabelKey = "experience.viewCompany",
  isLast = false,
  current = false,
} = Astro.props;
const t = useTranslations(getLang(Astro.url));
---

<div class="flex gap-4">
  <!-- Timeline line -->
  <div class="flex flex-col items-center">
    <div
      class:list={[
        "w-10 h-10 rounded-full bg-[var(--bg-card)] border grid place-items-center shrink-0",
        current
          ? "timeline-live relative border-[var(--signal)]"
          : "border-[var(--border-color)]",
      ]}
    >
      {
        logo ? (
          <img
            src={logo}
            alt=""
            class="h-6 w-6 object-contain"
            aria-hidden="true"
          />
        ) : mark ? (
          <span
            class="text-lg font-bold leading-none text-[var(--text-secondary)]"
            aria-hidden="true"
          >
            {mark}
          </span>
        ) : (
          <Icon
            name={icon}
            class="w-5 h-5 text-[var(--text-secondary)]"
            aria-hidden="true"
          />
        )
      }
    </div>
    {!isLast && <div class="w-px flex-1 bg-[var(--border-color)] mt-2" />}
  </div>

  <!-- Content -->
  <div class="pb-8">
    <span class="text-xs text-[var(--text-muted)] tracking-wider">
      {t(`${entryKey}.period`)}
    </span>
    <h3 class="text-lg mt-1">{t(`${entryKey}.title`)}</h3>
    <p class="text-[var(--text-secondary)] text-sm mt-0.5">
      {t(`${entryKey}.institution`)}
    </p>
    <p class="text-[var(--text-muted)] text-sm mt-2 leading-relaxed">
      {t(`${entryKey}.description`)}
    </p>
    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-1.5 text-xs text-[var(--text-secondary)] underline decoration-[var(--border-hover)] underline-offset-4 transition-colors hover:text-white"
        >
          <span>{t(linkLabelKey)}</span>
          <Icon name="mdi:open-in-new" class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      )
    }
  </div>
</div>
